\f0\fs24 \cf0 import os\
import shutil\
import threading\
import tkinter as tk\
from datetime import datetime\
from tkinter import filedialog, messagebox, scrolledtext\
\
\
class PhotoOrganizerApp:\
\
  def __init__(self, root):\
    self.root = root\
    self.root.title("iPhone \uc0\u29031 \u29255 \u19968 \u38190 \u28165 \u29702 \u19982 \u24402 \u31867 \u21161 \u25163 ")\
    self.root.geometry("520x420")\
    self.root.resizable(False, False)\
\
    # \uc0\u25991 \u20214 \u22841 \u36873 \u25321 \u21306 \u22495 \
    frame_top = tk.Frame(root, pady=15, padx=20)\
    frame_top.pack(fill="x")\
\
    tk.Label(\
        frame_top, text="\uc0\u30446 \u26631 \u29031 \u29255 \u25991 \u20214 \u22841 \u65306 ", font=("\u24494 \u36719 \u38597 \u40657 ", 10, "bold")\
    ).pack(anchor="w")\
\
    frame_path = tk.Frame(frame_top, pady=5)\
    frame_path.pack(fill="x")\
\
    self.path_var = tk.StringVar()\
    self.entry_path = tk.Entry(\
        frame_path, textvariable=self.path_var, width=48, state="readonly"\
    )\
    self.entry_path.pack(side="left", padx=(0, 10))\
\
    btn_browse = tk.Button(\
        frame_path, text="\uc0\u36873 \u25321 \u25991 \u20214 \u22841 ", command=self.select_folder, width=10\
    )\
    btn_browse.pack(side="right")\
\
    # \uc0\u21151 \u33021 \u36873 \u39033 \u21306 \u22495 \
    frame_opts = tk.LabelFrame(\
        root, text="\uc0\u25972 \u29702 \u36873 \u39033 ", padx=15, pady=10, font=("\u24494 \u36719 \u38597 \u40657 ", 9)\
    )\
    frame_opts.pack(fill="x", padx=20, pady=5)\
\
    self.var_clean = tk.BooleanVar(value=True)\
    tk.Checkbutton(\
        frame_opts,\
        text="\uc0\u33258 \u21160 \u28165 \u29702 \u25152 \u26377  .AAE \u32534 \u36753 \u35760 \u24405 \u21450  ._ \u38544 \u34255 \u22403 \u22334 \u23567 \u25991 \u20214 ",\
        variable=self.var_clean,\
    ).pack(anchor="w")\
\
    self.var_sort = tk.BooleanVar(value=True)\
    tk.Checkbutton(\
        frame_opts,\
        text="\uc0\u25353 \u29031 \u29255 /\u35270 \u39057 \u26085 \u26399 \u33258 \u21160 \u24402 \u31867 \u21040  [\u24180 -\u26376 ] \u25991 \u20214 \u22841 ",\
        variable=self.var_sort,\
    ).pack(anchor="w", pady=(5, 0))\
\
    # \uc0\u24320 \u22987 \u25353 \u38062 \
    self.btn_start = tk.Button(\
        root,\
        text="\uc0\u24320 \u22987 \u19968 \u38190 \u25972 \u29702 ",\
        command=self.start_thread,\
        bg="#0078D7",\
        fg="white",\
        font=("\uc0\u24494 \u36719 \u38597 \u40657 ", 11, "bold"),\
        height=2,\
        width=20,\
    )\
    self.btn_start.pack(pady=15)\
\
    # \uc0\u26085 \u24535 \u36755 \u20986 \u31383 \u21475 \
    tk.Label(root, text="\uc0\u22788 \u29702 \u26085 \u24535 \u65306 ", font=("\u24494 \u36719 \u38597 \u40657 ", 9)).pack(\
        anchor="w", padx=20\
    )\
    self.log_area = scrolledtext.ScrolledText(\
        root, height=8, width=65, font=("Consolas", 9)\
    )\
    self.log_area.pack(padx=20, pady=(2, 15))\
\
  def log(self, message):\
    self.log_area.insert(tk.END, message + "\\n")\
    self.log_area.see(tk.END)\
\
  def select_folder(self):\
    folder = filedialog.askdirectory()\
    if folder:\
      self.path_var.set(folder)\
      self.log(f"\uc0\u24050 \u36873 \u25321 \u25991 \u20214 \u22841 : \{folder\}")\
\
  def start_thread(self):\
    folder = self.path_var.get()\
    if not folder or not os.path.exists(folder):\
      messagebox.showwarning("\uc0\u25552 \u31034 ", "\u35831 \u20808 \u36873 \u25321 \u19968 \u20010 \u26377 \u25928 \u30340 \u29031 \u29255 \u25991 \u20214 \u22841 \u65281 ")\
      return\
    self.btn_start.config(state="disabled", text="\uc0\u27491 \u22312 \u22788 \u29702 \u20013 ...")\
    threading.Thread(\
        target=self.process_files, args=(folder,), daemon=True\
    ).start()\
\
  def process_files(self, folder):\
    deleted_count = 0\
    moved_count = 0\
    media_exts = \{\
        ".jpg",\
        ".jpeg",\
        ".png",\
        ".heic",\
        ".mov",\
        ".mp4",\
        ".gif",\
        ".raw",\
        ".dng",\
    \}\
\
    try:\
      # 1. \uc0\u28165 \u29702 \u22403 \u22334 \u25991 \u20214 \
      if self.var_clean.get():\
        self.log(">>> \uc0\u24320 \u22987 \u25195 \u25551 \u24182 \u28165 \u29702 \u26080 \u29992 \u23567 \u25991 \u20214 ...")\
        for root_dir, dirs, files in os.walk(folder):\
          for file in files:\
            lower_name = file.lower()\
            if lower_name.endswith(".aae") or file.startswith("._"):\
              file_path = os.path.join(root_dir, file)\
              try:\
                os.remove(file_path)\
                deleted_count += 1\
              except Exception as e:\
                self.log(f"\uc0\u21024 \u38500 \u22833 \u36133  \{file\}: \{e\}")\
        self.log(f"\uc0\u28165 \u29702 \u23436 \u25104 \u65306 \u20849 \u21024 \u38500  \{deleted_count\} \u20010 \u22403 \u22334 \u23567 \u25991 \u20214 \u12290 ")\
\
      # 2. \uc0\u25353 \u24180 \u26376 \u24402 \u31867 \u23186 \u20307 \u25991 \u20214 \
      if self.var_sort.get():\
        self.log(">>> \uc0\u24320 \u22987 \u25353 \u24180 \u26376 \u24402 \u31867 \u29031 \u29255 \u21644 \u35270 \u39057 ...")\
        for file in os.listdir(folder):\
          file_path = os.path.join(folder, file)\
          if os.path.isfile(file_path):\
            ext = os.path.splitext(file)[1].lower()\
            if ext in media_exts:\
              mtime = os.path.getmtime(file_path)\
              date_folder = datetime.fromtimestamp(mtime).strftime("%Y-%m")\
              target_dir = os.path.join(folder, date_folder)\
              os.makedirs(target_dir, exist_ok=True)\
\
              target_path = os.path.join(target_dir, file)\
              # \uc0\u36991 \u20813 \u21516 \u21517 \u35206 \u30422 \
              if os.path.exists(target_path):\
                base, extension = os.path.splitext(file)\
                target_path = os.path.join(\
                    target_dir, f"\{base\}_dup\{extension\}"\
                )\
\
              shutil.move(file_path, target_path)\
              moved_count += 1\
        self.log(f"\uc0\u24402 \u31867 \u23436 \u25104 \u65306 \u20849 \u25972 \u29702  \{moved_count\} \u20010 \u29031 \u29255 /\u35270 \u39057 \u25991 \u20214 \u12290 ")\
\
      self.log("=== \uc0\u20840 \u37096 \u22788 \u29702 \u23436 \u25104 \u65281  ===")\
      messagebox.showinfo(\
          "\uc0\u23436 \u25104 ",\
          f"\uc0\u25972 \u29702 \u23436 \u25104 \u65281 \\n\u21024 \u38500 \u22403 \u22334 \u25991 \u20214 \u65306 \{deleted_count\} \u20010 \\n\u24402 \u31867 \u23186 \u20307 \u25991 \u20214 \u65306 \{moved_count\} \u20010 ",\
      )\
\
    except Exception as e:\
      self.log(f"\uc0\u21457 \u29983 \u38169 \u35823 : \{e\}")\
      messagebox.showerror("\uc0\u38169 \u35823 ", f"\u22788 \u29702 \u36807 \u31243 \u20013 \u20986 \u29616 \u38382 \u39064 \u65306 \{e\}")\
    finally:\
      self.btn_start.config(state="normal", text="\uc0\u24320 \u22987 \u19968 \u38190 \u25972 \u29702 ")\
\
\
if __name__ == "__main__":\
  root = tk.Tk()\
  app = PhotoOrganizerApp(root)\
  root.mainloop()\
}